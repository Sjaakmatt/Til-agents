# Sprint 1 — all optional. Without Supabase/Redis the app runs in mock mode
# with an in-memory store, and the Signal agent can still be triggered from
# the dashboard.

MCP_MODE=mock

# Supabase (Sprint 3+): service role key needed for worker writes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (BullMQ). Use Upstash in production.
REDIS_URL=redis://127.0.0.1:6379

# LLM keys (Sprint 2+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
