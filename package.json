{
  "name": "insiders-lab-platform",
  "version": "0.1.0",
  "private": true,
  "description": "The Insiders Lab — autonomous content and growth agent platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @insiders-lab/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "worker": "pnpm --filter @insiders-lab/web worker",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  }
}
